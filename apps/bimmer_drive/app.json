{
  "id": "bimmer_drive",
  "title": "Camera & VietMap",
  "description": "Tích hợp 3-trong-1 siêu mượt cho đồng hồ & HUD BMW iDrive 7: (1) Camera gương xi nhan & Camera trước AR dẫn đường; (2) Biển tốc độ VietMap Live / Camera BMW / Bản đồ BMW kèm biển --- chuẩn hãng (lọc biển 5 km/h hầm xe, chớp mượt khi quá tốc); (3) Đưa màn hình giữa (VietMap Android Auto) lên đồng hồ. Chỉ dùng 1 dịch vụ gốc duy nhất, tự ngủ giải mã H.264 khi đi thẳng.",
  "version": "1.0.0",
  "startType": "autostart",
  "vendor": "custom",
  "loggingId": "OABD",
  "signals": {
    "de.bmw.body.Light": {
      "StatusFunctionsIndicators": "s",
      "StatusFunctionsIndicators2": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "vehicle speed for mirror limit, front camera threshold, blinker distance cap and overspeed pulse",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "instant reverse gear release so the rear-view camera never waits",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.video.cameraproxy.ICAM2Proxy": "*",
    "de.bmw.infotainment.video.cameraproxy.CameraProxy": "*",
    "de.bmw.dass.XView3D": "*"
  },
