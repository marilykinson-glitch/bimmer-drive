      "_optional": "the car's speed: the speed limit setting does nothing then",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "instant reverse gear release so the rear-view camera never waits",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.video.cameraproxy.ICAM2Proxy": "*",
