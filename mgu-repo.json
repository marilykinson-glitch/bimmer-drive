{
  "schema": 1,
  "components": [
    {
      "id": "bimmer_drive",
      "kind": "app",
      "path": "apps/bimmer_drive",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "bimmer-drive": "1.1.3",
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "kit/tools/build.py",
        "args": [
          "--language",
          "vi",
          "--plain-version",
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit/runtime",
          "kit/platform",
          "kit/localization",
          "kit/tools/build.py",
          "kit/tools/pack_data.py",
          "kit/tools/localize.py",
          "kit/tools/locale-revisions.json",
          "kit/tools/oapgen",
          "oap-sdk"
        ]
      }
    },
    {
      "id": "anh_dai_dien",
      "kind": "app",
      "path": "apps/anh_dai_dien",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "anh-dai-dien": "1.0.3",
        "bimmer-drive": "1.0.3",
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "kit/tools/build.py",
        "args": [
          "--language",
          "vi",
          "--plain-version",
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit/runtime",
          "kit/platform",
          "kit/localization",
          "kit/tools/build.py",
          "kit/tools/pack_data.py",
          "kit/tools/localize.py",
          "kit/tools/locale-revisions.json",
          "kit/tools/oapgen",
          "oap-sdk"
        ]
      }
    }
  ],
  "tools": [
    {
      "id": "bimmer-drive",
      "path": "tools/bimmer-drive",
      "title": "Trợ thủ Camera & VietMap",
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "bimmer-drive-log",
      "path": "tools/bimmer-drive-log",
      "title": "Nhật ký Camera & VietMap",
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "anh-dai-dien",
      "path": "tools/anh-dai-dien",
      "title": "Trợ thủ MGU Studio (On-Demand)",
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
