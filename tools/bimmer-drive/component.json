{
  "id": "bimmer-drive",
  "kind": "tool",
  "version": "1.0.3",
  "title": "Trợ thủ Camera & VietMap",
  "description": "Dịch vụ gốc hợp nhất cho Camera xi nhan, Camera trước AR dẫn đường, Biển báo tốc độ VietMap / KAFAS / Bản đồ BMW (kèm biển --- chuẩn hãng) và Đưa màn giữa lên đồng hồ; đồng thời kích hoạt MGU Studio theo yêu cầu (0 MB RAM khi không mở).",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11",
    "cluster-render": "0.5.10"
  },
  "files": [
    {
      "path": "bimmer-drive.js",
      "mode": "0644"
    },
    {
      "path": "signs-cam.js",
      "mode": "0644"
    },
    {
      "path": "woc-mirror.js",
      "mode": "0644"
    },
    {
      "path": "oapgen-gen.js",
      "mode": "0644"
    },
    {
      "path": "probe.js",
      "mode": "0644"
    },
    {
      "path": "digits.json",
      "mode": "0644"
    },
    {
      "path": "digit-templates.json",
      "mode": "0644"
    },
    {
      "path": "jpeg.js",
      "mode": "0644"
    },
    {
      "path": "signread.js",
      "mode": "0644"
    },
    {
      "path": "mgu-sidecam",
      "mode": "0755"
    },
    {
      "path": "NOTICE.md",
      "mode": "0644"
    },
    {
      "path": "OFL-Inter.txt",
      "mode": "0644"
    },
    {
      "path": "LICENSE.GPL-3.0",
      "mode": "0644"
    },
    {
      "path": "LICENSE.MPL-2.0",
      "mode": "0644"
    },
    {
      "path": "LICENSE.ffmpeg",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bimmer-drive.service"
    }
  ],
  "enable": [
    {
      "unit": "bimmer-drive.service",
      "target": "multi-user.target"
    }
  ],
  "dropins": [
    {
      "unit": "waze-on-cluster.service",
      "name": "bimmer-drive.conf",
      "from": "woc-dropin.conf"
    }
  ],
  "recmgr": [
    "bimmer-drive"
  ],
  "crashNames": [
    "mgu-sidecam"
  ],
  "restart": [
    "bimmer-drive.service"
  ],
  "deactivate": [
    "node",
    "bimmer-drive.js",
    "deactivate"
  ]
}
